digraph G {rankdir=TB;graph[bgcolor="white",pad=.2];node[shape=box,style="rounded,filled",fillcolor="#F0F6EA",color="#548343",fontname="DejaVu Sans",fontsize=10];edge[fontname="DejaVu Sans",fontsize=9];input[label="Вход: заявки, специалисты,\nквалификация, слоты, SLA"];var[label="Создать бинарные x[i,j,s]"];limit[label="Ограничения:\n1 заявка — 1 назначение\n1 специалист — 1 задача/час\nлимит нагрузки"];opt[label="Минимизировать штрафы\nза пропуск и просрочку"];solve[label="PuLP → CBC"];out[label="Выход: назначения,\nне назначенные, загрузка"];view[label="Plotly Гант\nExcel / PDF / JSON"];input->var->limit->opt->solve->out->view;}